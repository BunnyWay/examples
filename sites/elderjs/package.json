{
  "name": "elderjs",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "dev": "rollup -c -w --no-watch.clearScreen",
    "build": "node ./src/cleanPublic.js && rollup -c && node ./src/build.js",
    "serve": "node ./src/cleanPublic.js && rollup -c && NODE_ENV=production node ./src/server.js"
  },
  "dependencies": {
    "@elderjs/elderjs": "^1.7.5",
    "@elderjs/plugin-browser-reload": "^1.3.2",
    "@elderjs/plugin-markdown": "^1.3.2",
    "@elderjs/plugin-seo-check": "^1.3.2",
    "body-parser": "^1.19.0",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "del": "^6.0.0",
    "dotenv": "^8.2.0",
    "fs-extra": "^9.1.0",
    "glob": "^7.1.6",
    "polka": "^0.5.2",
    "sirv": "^1.0.11",
    "svelte": "^3.38.3",
    "svelte-preprocess": "^4.6.9"
  },
  "devDependencies": {
    "autoprefixer": "^10.2.5",
    "postcss": "^8.2.8",
    "rollup": "^2.41.1"
  },
  "overrides": {
    "cheerio": "1.0.0-rc.12"
  }
}
