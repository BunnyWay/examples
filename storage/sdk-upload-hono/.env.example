# Copy to .env. The zone name and password are on the storage zone's Access tab.

BUNNY_STORAGE_ZONE=
# Anyone with the password can write to the zone, so keep it on the server.
BUNNY_STORAGE_PASSWORD=
# The zone's main region: de, uk, ny, la, sg, se, br, jh, or syd.
BUNNY_STORAGE_REGION=de
# A pull zone connected to the storage zone, used for the download links.
BUNNY_PULL_ZONE_URL=https://myapp.b-cdn.net
