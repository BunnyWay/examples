# Copy to .env. Bun reads these S3_* variables automatically.
# All values are on the storage zone's Access tab. The zone needs S3 compatibility,
# which you can only switch on when you create it.

# The storage zone name is both the access key ID and the bucket.
S3_ACCESS_KEY_ID=your-storage-zone
S3_BUCKET=your-storage-zone
# The storage zone password. Keep it out of git.
S3_SECRET_ACCESS_KEY=
# The zone's main region: de, ny, sg, uk, se, la, jh, or syd.
S3_REGION=de
S3_ENDPOINT=https://de-s3.storage.bunnycdn.com
