# Copy to .env. All values are on the storage zone's Access tab.
# The zone needs S3 compatibility, which you can only switch on when you create it.

# The storage zone name. S3 uses it as both the access key ID and the bucket.
BUNNY_STORAGE_ZONE=
# The storage zone password. Anyone with it can write to the zone, so keep it on the server.
BUNNY_STORAGE_PASSWORD=
# The zone's main region: de, ny, sg, uk, se, la, jh, or syd.
BUNNY_STORAGE_REGION=de
