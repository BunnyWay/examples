# Copy to .env. The library and video IDs are on the video's page in the Bunny Stream dashboard.
# The token authentication key is on the library's Security page. It can sign a link
# to any video in the library, so keep it on the server and out of git.
NUXT_BUNNY_STREAM_LIBRARY_ID=
NUXT_BUNNY_STREAM_VIDEO_ID=
NUXT_BUNNY_STREAM_TOKEN_AUTH_KEY=
