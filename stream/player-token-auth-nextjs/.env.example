# Copy to .env.local. The library and video IDs are on the video's page in the Bunny Stream dashboard.
BUNNY_STREAM_LIBRARY_ID=
BUNNY_STREAM_VIDEO_ID=
# On the library's Security page, under embed view token authentication.
# Anyone with this key can sign links to every video in the library, so keep it on the server and out of git.
BUNNY_STREAM_TOKEN_AUTH_KEY=
