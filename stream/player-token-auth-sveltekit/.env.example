# Copy to .env. The library ID is on the library's API page, and the video ID is on the video's page.
BUNNY_STREAM_LIBRARY_ID=
BUNNY_STREAM_VIDEO_ID=
# From the library's Security page. Anyone with this key can sign links to any video
# in the library, so keep it on the server and out of git.
BUNNY_STREAM_TOKEN_AUTH_KEY=
