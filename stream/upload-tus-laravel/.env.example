# Copy to .env. Both values are on the library's API page in the Bunny Stream dashboard.
# The API key can create and delete videos, so keep it on the server and out of git.
BUNNY_STREAM_LIBRARY_ID=
BUNNY_STREAM_API_KEY=

APP_NAME="Upload to Bunny Stream with TUS"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

# No database needed: sessions and cache are kept on disk in storage/.
SESSION_DRIVER=file
CACHE_STORE=file
